{
  "name": "@lone-wolf-akela/dsh-pwsh-codepage-fix",
  "version": "0.1.0",
  "description": "Fixes the DSH pwsh tool's encoding defects: UTF-8 parser errors even when the command has a syntax error, [Console]::InputEncoding pinned to UTF-8, and ConstrainedLanguage-safe read-only mode.",
  "type": "module",
  "license": "MIT",
  "author": "lone-wolf-akela",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lone-wolf-akela/dsh-pwsh-codepage-fix.git"
  },
  "homepage": "https://github.com/lone-wolf-akela/dsh-pwsh-codepage-fix#readme",
  "bugs": {
    "url": "https://github.com/lone-wolf-akela/dsh-pwsh-codepage-fix/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./plan": "./lib/plan.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/plan.test.mjs test/behaviour.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-pwsh-sandbox": "^0.2.0-rc.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "powershell",
    "pwsh",
    "encoding",
    "utf-8",
    "windows"
  ]
}
